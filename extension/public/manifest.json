{
  "manifest_version": 3,
  "name": "GDS PNR Lookup",
  "version": "1.0.0",
  "description": "Fills Surname + PNR on the airline's Manage Booking page. You press Enter; it captures the result and fills the next one.",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "sidePanel",
    "activeTab",
    "alarms"
  ],
  "host_permissions": [
    "https://*.malaysiaairlines.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "GDS PNR Lookup"
  }
}
