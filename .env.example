GEMINI_API_KEY=
GEMINI_MODEL_EXTRACT=gemini-3.6-flash
GEMINI_MODEL_RESULT=gemini-3.1-flash-lite
# Thinking: off | low | medium | high. Pro models need at least "low".
GEMINI_THINKING_EXTRACT=off
GEMINI_THINKING_RESULT=off
GEMINI_CONCURRENCY=8
GEMINI_TIMEOUT_SECONDS=120
GEMINI_MAX_RETRIES=3

# Pricing per 1M tokens (USD, paid tier, checked 2026-09-24), editable without code changes.
# gemini-3.6-flash: 0.75 / 3.75 until 2026-12-31, then 1.50 / 7.50.
PRICE_INPUT_PER_M=0.75
PRICE_OUTPUT_PER_M=3.75
PRICE_RESULT_INPUT_PER_M=0.25
PRICE_RESULT_OUTPUT_PER_M=1.50
# FLT credits: the only account that may add FLT (sign in with this email to see "Add a plan")
FLT_ADMIN_EMAIL=shekhawatk271@gmail.com

CONFIDENCE_THRESHOLD=0.85

# Single login for the web app
APP_EMAIL=
APP_PASSWORD=
DATA_DIR=./data
MAX_FILE_SIZE_MB=20
MAX_IMAGES_PER_JOB=500
DELETE_FILES_AFTER_DAYS=7
LOG_LEVEL=INFO

# Extension API (python -m app.api). On the VPS, Caddy serves it at https://<domain>/api
API_HOST=127.0.0.1
API_PORT=8000
# CORS: comma-separated, e.g. chrome-extension://<extension id> (shown on chrome://extensions)
ALLOWED_EXTENSION_ORIGINS=
LEASE_MINUTES=10
